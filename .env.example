# settfex: copy to .env and fill in what you use. .env is gitignored; never commit tokens.

# --- Bank of Thailand API (settfex 1.0.0+) --------------------------------------------------
# Free tokens from https://portal.api.bot.or.th (guide: https://portal.api.bot.or.th/manual).
# Each credential is bound to ONE product: paste each product's "Token" (not "Token Hash").
BANK_OF_THAILAND_TOKEN_INTEREST_RATES=
BANK_OF_THAILAND_TOKEN_STATISTICS=
BANK_OF_THAILAND_TOKEN_EXCHANGE_RATES=
BANK_OF_THAILAND_TOKEN_DEBT_SECURITIES_AUCTION=
BANK_OF_THAILAND_TOKEN_OTHERS=
BANK_OF_THAILAND_TOKEN_LICENSE_CHECK=
# Fallback for any product without its own key:
BANK_OF_THAILAND_TOKEN=
